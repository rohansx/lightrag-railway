# =====================================================
# LightRAG Railway Template Configuration
# =====================================================

# Server Configuration
PORT=9621
WORKING_DIR=/app/data/rag_storage
INPUT_DIR=/app/data/inputs

# =====================================================
# LLM Configuration (REQUIRED - Choose ONE binding)
# Options: openai, ollama, azure_openai, aws_bedrock
# =====================================================
LLM_BINDING=openai
LLM_MODEL=gpt-4o-mini
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_BINDING_API_KEY=sk-your-openai-key-here

# LLM Settings
LLM_TIMEOUT=180
MAX_ASYNC=4
MAX_PARALLEL_INSERT=2

# =====================================================
# Embedding Configuration (REQUIRED)
# Options: openai, ollama, azure_openai, jina
# =====================================================
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
# EMBEDDING_BINDING_API_KEY= (uses LLM_BINDING_API_KEY if not set)

# =====================================================
# Storage Configuration (Optional - defaults work fine)
# =====================================================
# LIGHTRAG_KV_STORAGE=JsonKVStorage
# LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
# LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
# LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage

# =====================================================
# Alternative: Use Ollama (Free, Self-hosted LLM)
# Requires separate Ollama service
# =====================================================
# LLM_BINDING=ollama
# LLM_MODEL=llama3.1:8b
# LLM_BINDING_HOST=http://ollama:11434
# EMBEDDING_BINDING=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIM=768

# =====================================================
# Alternative: Use OpenRouter (Multiple Models)
# =====================================================
# LLM_BINDING=openai
# LLM_MODEL=anthropic/claude-sonnet-4-20250514
# LLM_BINDING_HOST=https://openrouter.ai/api/v1
# LLM_BINDING_API_KEY=sk-or-your-key