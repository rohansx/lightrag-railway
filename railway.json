{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "lightrag-server --host 0.0.0.0 --port $PORT --working-dir $WORKING_DIR --input-dir $INPUT_DIR",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
